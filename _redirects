/README.md                  /404.html                                    404
/REPLIT.md                  /404.html                                    404
/SECURITY.md                /404.html                                    404
/SETUP.md                    /404.html                                    404
/SUPABASE_CHANGES.md        /404.html                                    404
/REACT_MIGRATION_REPORT.md  /404.html                                    404

# Orion extension live loader files (served publicly for auto-updates)
/.pages-orion/*             /.pages-orion/:splat                           200

# ============================================================================
# CATCH-ALL FOR REACT SPA
# ============================================================================
# Any route not matched above → React index.html for SPA routing
# React Router handles: /, /listings, /property?id=..., etc.
/*                          /index.html                                  200
