# _redirects — Cloudflare Pages
# Hybrid routing: React SPA for public pages, legacy HTML for protected flows

# ============================================================================
# PROTECTED FLOWS (Legacy HTML)
# ============================================================================

# Admin dashboard (legacy)
/admin                      /admin/dashboard.html                        302
/admin/                    /admin/dashboard.html                        302
/admin/*                    /admin/dashboard.html                        200

# Application flow (legacy)
/apply.html                 /apply/                                      302
/apply/login.html           /apply/?path=dashboard                       302
/apply/dashboard.html       /apply/?path=dashboard                       302
/apply/success.html         /apply/?path=dashboard                       302
/apply/lease.html           /apply/                                      302
/apply/*                    /apply/index.html                            200

# Tenant dashboard (legacy)
/tenant/*                   /tenant/index.html                           200

# Legacy landlord routes (legacy)
/landlord/properties.html   /landlord/dashboard.html                      302
/landlord/properties        /landlord/dashboard.html                      302
/landlord/listings.html     /landlord/dashboard.html                      302
/landlord/listings          /landlord/dashboard.html                      302
/landlord/messages.html     /landlord/inquiries.html                     302
/landlord/messages          /landlord/inquiries.html                     302
/landlord/*                 /landlord/index.html                         200

# Auth flows (legacy)
/auth/*                     /auth/callback.html                          200

# Lease and verification flows (legacy)
/lease-sign.html            /lease-sign.html                             200
/verify-lease.html          /verify-lease.html                           200

# ============================================================================
# PUBLIC PAGES (React SPA)
# ============================================================================
# React handles routing internally: /, /listings, /property, etc.
# All public routes default to index.html for SPA routing
/property                     /property-react.html                          200
/property/                    /property-react.html                          200
/listings                     /listings-react.html                          200
/listings/                    /listings-react.html                          200
/property.html                /property-react.html                          200
/listings.html                /listings-react.html                          200

# ============================================================================
# BLOCKED PATHS (Security & Privacy)
# ============================================================================
# Block source / config / docs from being served on the CDN
# (Cloudflare Pages serves static files before _redirects is consulted
#  only for exact file matches; wildcard rules below override static serving
#  for anything we explicitly don't want public.)

/SETUP.sql                  /404.html                                    404
/MIGRATION_SCHEMA.sql       /404.html                                    404
/MISSING_SCHEMA.sql         /404.html                                    404
/GAS-EMAIL-RELAY.gs         /404.html                                    404
/generate-config.js         /404.html                                    404
/deploy.sh                  /404.html                                    404
/push.sh                    /404.html                                    404
/scripts/*                  /404.html                                    404
/supabase/*                 /404.html                                    404
/.agents/*                  /404.html                                    404
/.github/*                  /404.html                                    404
/.githooks/*                /404.html                                    404
/db/*                       /404.html                                    404
/docs/*                     /404.html                                    404
/lease-phases/*             /404.html                                    404
/components/*               /404.html                                    404

# Developer / planning docs — blocked from public access
/ARCHITECTURE.md            /404.html                                    404
/CONTRIBUTING.md            /404.html                                    404
/DEPLOYMENT_GUIDE.md        /404.html                                    404
