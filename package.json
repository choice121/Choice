{
  "name": "choice-properties",
  "version": "1.0.0",
  "private": true,
  "description": "Choice Properties — Nationwide rental property marketplace. Deployed exclusively to Cloudflare Pages.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node generate-config.js && vite build && node scripts/copy-static-to-dist.js",
    "build:pages": "node generate-config.js && vite build && node scripts/copy-static-to-dist.js",
    "preview": "vite preview --host 0.0.0.0",
    "test:location-visual": "playwright test",
    "bump-extension": "node scripts/sync-and-bump-extension.mjs",
    "validate-extension": "node scripts/validate-extension.mjs",
    "lint": "node scripts/check-js-syntax.mjs",
    "setup-credentials": "node scripts/open-setup.mjs",
    "load-credentials": "node scripts/setup-credentials.mjs",
    "setup-direct": "node setup-direct.mjs",
    "start": "vite --host 0.0.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "apify-client": "^2.25.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  }
}
